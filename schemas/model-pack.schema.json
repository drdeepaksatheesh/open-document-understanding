{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-document-understanding.local/schemas/model-pack.schema.json",
  "title": "Open Document Understanding Model Pack Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "packId",
    "packVersion",
    "engineId",
    "engineVersion",
    "operation",
    "sourceLanguages",
    "targetLanguages",
    "local",
    "license",
    "files"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packId": { "type": "string", "minLength": 1 },
    "packVersion": { "type": "string", "minLength": 1 },
    "engineId": { "type": "string", "minLength": 1 },
    "engineVersion": { "type": "string", "minLength": 1 },
    "operation": { "enum": ["translate", "explain"] },
    "sourceLanguages": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "targetLanguages": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "local": { "const": true },
    "license": { "type": "string", "minLength": 1 },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
