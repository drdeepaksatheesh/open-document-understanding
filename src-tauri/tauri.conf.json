{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Document Understanding",
  "version": "0.1.0-alpha.1",
  "identifier": "org.opendocumentunderstanding.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Open Document Understanding",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; script-src 'self' 'wasm-unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Education",
    "shortDescription": "Local-first document understanding reader",
    "longDescription": "A privacy-first reader for understanding documents in the language and level the reader needs while preserving the original source."
  }
}
